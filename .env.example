# Copy to .env and fill in. .env is git-ignored.
# Models are set only here; config.py has no default for them.

# Local models through Ollama's OpenAI-compatible endpoint. No key needed.
OLLAMA__DEFAULT_MODEL=qwen2.5:14b

# Hosted models through OpenRouter. Get a key at https://openrouter.ai/keys
# Model ids are listed at https://openrouter.ai/models
OPENROUTER__DEFAULT_MODEL=liquid/lfm-2.5-2.6b:free
OPENROUTER__API_KEY=
